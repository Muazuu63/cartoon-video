{
  "language": "bn",
  "segments": [
    {
      "start": 0.0,
      "end": 3.0,
      "text": "ভাই... আমার ছেলে ক্লাস থ্রিতে পড়ে, বুঝছেন?"
    },
    {
      "start": 3.0,
      "end": 6.8,
      "text": "আচ্ছা... তার নাকি একটা গার্লফ্রেন্ড আছে। তার সাথে আবার ব্রেকআপও হইছে।"
    },
    {
      "start": 6.8,
      "end": 9.2,
      "text": "ক্লাস কিসে পড়ে? থ্রিতে। হায় হায়..."
    },
    {
      "start": 9.2,
      "end": 12.2,
      "text": "তো ওরে জিজ্ঞেস করলাম, কি বাবা ব্রেকআপ করছো কেন?"
    },
    {
      "start": 12.2,
      "end": 14.0,
      "text": "কয় বাবা আর বইলো না..."
    },
    {
      "start": 14.0,
      "end": 17.0,
      "text": "আমার গার্লফ্রেন্ড আমারে না জানাইয়া ন্যাড়া মাথা করছে!"
    },
    {
      "start": 17.0,
      "end": 19.5,
      "text": "কিরে? হাহাহা..."
    },
    {
      "start": 19.5,
      "end": 21.26,
      "text": "ন্যাড়া ন্যাড়া... গোপাল গোপাল..."
    }
  ]
}
